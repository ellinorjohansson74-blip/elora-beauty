/* ÉLORA – Design för artikelsidorna */

#artikel {
  max-width: 850px;
  margin: 70px auto 100px;
  padding: 0 25px;
  color: #68483e;
}

#artikel h1 {
  font-family: Georgia, serif;
  font-size: 32px;
  line-height: 1.2;
  margin-bottom: 30px;
}

#artikel h2 {
  font-family: Georgia, serif;
  font-size: 24px;
  margin-top: 45px;
  margin-bottom: 20px;
}

#artikel h3 {
  font-family: Georgia, serif;
  font-size: 23px;
  margin-top: 30px;
  margin-bottom: 15px;
}

#artikel p {
  font-size: 16px;
  line-height: 1.9;
  margin-bottom: 22px;
}

#artikel img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 5px;
  margin: 35px 0;
}

#artikel ul,
#artikel ol {
  padding-left: 25px;
  margin-bottom: 30px;
  line-height: 1.9;
}

#artikel li {
  margin-bottom: 10px;
}

/* Anpassning för mobilskärmar */
@media (max-width: 768px) {
  #artikel {
    margin: 40px auto 70px;
    padding: 0 20px;
  }

  #artikel h1 {
    font-size: 32px;
  }

  #artikel h2 {
    font-size: 25px;
  }
}
#artikel h2 {
  font-size: 24px !important;
  line-height: 1.4;
}
#article-content h2 {
  font-size: 24px;
  line-height: 1.3;
}
.journal-article #article-content h2 {
  font-family: Georgia, serif;
  font-size: 24px !important;
  line-height: 1.3;
}
